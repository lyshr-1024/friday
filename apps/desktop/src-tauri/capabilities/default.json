{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主浮窗与设置页的权限",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "autostart:default",
    "opener:default"
  ]
}
