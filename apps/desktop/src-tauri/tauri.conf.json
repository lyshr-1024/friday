{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Friday",
  "version": "0.1.0",
  "identifier": "com.haoran.friday",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "zsh ../../scripts/bundle-core.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Friday",
        "width": 680,
        "height": 56,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*",
      "devCsp": "default-src 'self' 'unsafe-inline' http://localhost:1420 ws://localhost:1420 http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": { "resources/core": "core" },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Friday Dev"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
